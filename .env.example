# --- Database ---
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=portofolio
DB_PORT=5432

# --- Server ---
INTERNAL_PORT=8080
PORT=8080
GIN_MODE=debug

# --- Auth ---
# WAJIB diisi, gunakan secret acak panjang (mis. `openssl rand -base64 48`).
JWT_SECRET=change-me

# Akun admin pertama kali di-seed dari sini. WAJIB diisi (tidak ada default lagi).
# Password minimal 12 karakter.
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me-min-12-chars

# Set ke "true" HANYA untuk development lokal via http:// (bukan https://).
# Di production/staging, biarkan kosong/false agar cookie auth diberi flag Secure.
COOKIE_INSECURE=false

# --- CORS ---
# Daftar origin frontend yang diizinkan, dipisah koma. Jangan gunakan wildcard "*".
ALLOWED_ORIGINS=http://localhost:5173

# --- Reverse Proxy (opsional) ---
# Isi dengan IP reverse proxy Anda (nginx/Traefik/Cloudflare) jika API ini ada di
# belakangnya, dipisah koma. Kosongkan jika API diakses langsung tanpa proxy di depannya.
TRUSTED_PROXIES=

# --- Payment Gateway ---
PAYMENT_GATEWAY_URL=https://your-payment-gateway.example.com
PAYMENT_GATEWAY_API_KEY=change-me
